// ============================================
//   skf-hash — хеши, пароли, кодирование
//   от SkyMonder
// ============================================


// --------------------------------------------
//   ХЕШИ
// --------------------------------------------

функция md5(текст) {
    // MD5-хеш строки (hex)
    подключить_питон("hashlib")
    вернуть hashlib.md5(текст.encode("utf-8")).hexdigest()
}

функция sha1(текст) {
    // SHA-1 хеш строки (hex)
    подключить_питон("hashlib")
    вернуть hashlib.sha1(текст.encode("utf-8")).hexdigest()
}

функция sha256(текст) {
    // SHA-256 хеш строки (hex)
    подключить_питон("hashlib")
    вернуть hashlib.sha256(текст.encode("utf-8")).hexdigest()
}

функция sha512(текст) {
    // SHA-512 хеш строки (hex)
    подключить_питон("hashlib")
    вернуть hashlib.sha512(текст.encode("utf-8")).hexdigest()
}

функция sha3(текст) {
    // SHA-3 хеш строки (hex)
    подключить_питон("hashlib")
    вернуть hashlib.sha3_256(текст.encode("utf-8")).hexdigest()
}

функция blake2(текст) {
    // BLAKE2 хеш строки (hex)
    подключить_питон("hashlib")
    вернуть hashlib.blake2b(текст.encode("utf-8")).hexdigest()
}

функция хеш(текст, алгоритм) {
    // Универсальный хеш: алгоритм = "md5", "sha1", "sha256", "sha512", "sha3", "blake2"
    подключить_питон("hashlib")
    
    пусть а = алгоритм.в_нижний()
    если (а == "md5") { вернуть md5(текст) }
    если (а == "sha1") { вернуть sha1(текст) }
    если (а == "sha256") { вернуть sha256(текст) }
    если (а == "sha512") { вернуть sha512(текст) }
    если (а == "sha3") { вернуть sha3(текст) }
    если (а == "blake2") { вернуть blake2(текст) }
    
    бросить "Неизвестный алгоритм: " + алгоритм
}

функция хеш_файла(путь, алгоритм) {
    // Хеш содержимого файла (читает по частям, не грузит всё в память)
    подключить_питон("hashlib")
    
    если (алгоритм == ничего) {
        алгоритм = "sha256"
    }
    
    пусть h = hashlib.new(алгоритм)
    пусть файл = open(путь, "rb")
    
    пока (истина) {
        пусть кусок = файл.read(65536)
        если (длина(кусок) == 0) {
            прервать
        }
        h.update(кусок)
    }
    
    файл.close()
    вернуть h.hexdigest()
}


// --------------------------------------------
//   ПАРОЛИ
// --------------------------------------------

функция сгенерировать_пароль(длина, символы) {
    // Генерирует случайный пароль. По умолчанию — буквы+цифры+символы.
    подключить_питон("secrets")
    подключить_питон("string")
    
    если (длина == ничего) {
        длина = 16
    }
    если (символы == ничего) {
        символы = string.ascii_letters + string.digits + "!@#$%^&*()-_=+"
    }
    
    пусть результат = ""
    пусть i = 0
    пока (i < длина) {
        результат = результат + secrets.choice(символы)
        i = i + 1
    }
    вернуть результат
}

функция сгенерировать_пин(длина) {
    // Генерирует числовой ПИН-код
    подключить_питон("secrets")
    
    если (длина == ничего) {
        длина = 4
    }
    
    пусть результат = ""
    пусть i = 0
    пока (i < длина) {
        результат = результат + строка(secrets.randbelow(10))
        i = i + 1
    }
    вернуть результат
}

функция сгенерировать_токен(длина) {
    // Генерирует безопасный URL-safe токен (для API, ссылок и т.д.)
    подключить_питон("secrets")
    
    если (длина == ничего) {
        длина = 32
    }
    
    вернуть secrets.token_urlsafe(длина)
}

функция сгенерировать_hex(длина) {
    // Генерирует случайную hex-строку
    подключить_питон("secrets")
    
    если (длина == ничего) {
        длина = 16
    }
    
    вернуть secrets.token_hex(длина)
}

функция стойкость_пароля(пароль) {
    // Оценка стойкости: 0-4 (0 — ужасно, 4 — отлично)
    пусть балл = 0
    
    если (длина(пароль) >= 8) { балл = балл + 1 }
    если (длина(пароль) >= 12) { балл = балл + 1 }
    
    пусть есть_нижний = ложь
    пусть есть_верхний = ложь
    пусть есть_цифра = ложь
    пусть есть_символ = ложь
    
    для (буква в пароль.символы()) {
        если (буква >= "a" и буква <= "z") { есть_нижний = истина }
        иначе если (буква >= "A" и буква <= "Z") { есть_верхний = истина }
        иначе если (буква >= "0" и буква <= "9") { есть_цифра = истина }
        иначе { есть_символ = истина }
    }
    
    если (есть_нижний и есть_верхний) { балл = балл + 1 }
    если (есть_цифра) { балл = балл + 1 }
    если (есть_символ) { балл = балл + 1 }
    
    если (балл > 4) { балл = 4 }
    вернуть балл
}

функция оценка_пароля(пароль) {
    // Текстовая оценка: "Ужасно", "Слабо", "Нормально", "Хорошо", "Отлично"
    пусть уровень = стойкость_пароля(пароль)
    пусть слова = ["Ужасно", "Слабо", "Нормально", "Хорошо", "Отлично"]
    вернуть слова[уровень]
}


// --------------------------------------------
//   BASE64
// --------------------------------------------

функция base64_кодировать(текст) {
    // Кодирует текст в base64
    подключить_питон("base64")
    пусть байты = текст.encode("utf-8")
    вернуть base64.b64encode(байты).decode("utf-8")
}

функция base64_декодировать(текст) {
    // Декодирует base64 в текст
    подключить_питон("base64")
    попробовать {
        пусть байты = base64.b64decode(текст)
        вернуть байты.decode("utf-8")
    } поймать (ошибка) {
        бросить "Не удалось декодировать base64: " + ошибка
    }
}

функция base64_url_кодировать(текст) {
    // URL-safe base64 (безопасно для ссылок)
    подключить_питон("base64")
    пусть байты = текст.encode("utf-8")
    вернуть base64.urlsafe_b64encode(байты).decode("utf-8")
}

функция base64_url_декодировать(текст) {
    подключить_питон("base64")
    попробовать {
        пусть байты = base64.urlsafe_b64decode(текст)
        вернуть байты.decode("utf-8")
    } поймать (ошибка) {
        бросить "Не удалось декодировать URL base64: " + ошибка
    }
}


// --------------------------------------------
//   BASE32 / BASE16
// --------------------------------------------

функция base32_кодировать(текст) {
    подключить_питон("base64")
    вернуть base64.b32encode(текст.encode("utf-8")).decode("utf-8")
}

функция base32_декодировать(текст) {
    подключить_питон("base64")
    попробовать {
        вернуть base64.b32decode(текст).decode("utf-8")
    } поймать (ошибка) {
        бросить "Не удалось декодировать base32: " + ошибка
    }
}

функция hex_кодировать(текст) {
    // Кодирует текст в hex (base16)
    подключить_питон("binascii")
    вернуть binascii.hexlify(текст.encode("utf-8")).decode("utf-8")
}

функция hex_декодировать(текст) {
    подключить_питон("binascii")
    попробовать {
        вернуть binascii.unhexlify(текст).decode("utf-8")
    } поймать (ошибка) {
        бросить "Не удалось декодировать hex: " + ошибка
    }
}


// --------------------------------------------
//   UUID
// --------------------------------------------

функция uuid4() {
    // Случайный UUID версии 4
    подключить_питон("uuid")
    вернуть строка(uuid.uuid4())
}

функция uuid1() {
    // UUID версии 1 (на основе времени и MAC-адреса)
    подключить_питон("uuid")
    вернуть строка(uuid.uuid1())
}

функция uuid_короткий() {
    // Короткий UUID без дефисов (32 hex-символа)
    пусть u = uuid4()
    вернуть u.заменить("-", "")
}

функция валидный_uuid?(текст) {
    // Проверяет, является ли строка валидным UUID
    подключить_питон("uuid")
    попробовать {
        uuid.UUID(текст)
        вернуть истина
    } поймать (ошибка) {
        вернуть ложь
    }
}


// --------------------------------------------
//   ХЕШИРОВАНИЕ ПАРОЛЕЙ (с солью)
// --------------------------------------------

функция хешировать_пароль(пароль) {
    // Создаёт безопасный хеш пароля с солью (PBKDF2-SHA256).
    // Возвращает строку вида "соль$хеш" — сохраняй её целиком.
    подключить_питон("hashlib")
    подключить_питон("os")
    подключить_питон("base64")
    
    пусть соль = os.urandom(16)
    пусть ключ = hashlib.pbkdf2_hmac("sha256", пароль.encode("utf-8"), соль, 100000)
    
    пусть соль_b64 = base64.b64encode(соль).decode("utf-8")
    пусть ключ_b64 = base64.b64encode(ключ).decode("utf-8")
    
    вернуть соль_b64 + "$" + ключ_b64
}

функция проверить_пароль(пароль, хеш) {
    // Проверяет, соответствует ли пароль сохранённому хешу
    подключить_питон("hashlib")
    подключить_питон("base64")
    
    попробовать {
        пусть части = хеш.разделить("$")
        если (длина(части) != 2) {
            вернуть ложь
        }
        
        пусть соль = base64.b64decode(части[0])
        пусть ожидаемый = base64.b64decode(части[1])
        пусть вычисленный = hashlib.pbkdf2_hmac("sha256", пароль.encode("utf-8"), соль, 100000)
        
        вернуть вычисленный == ожидаемый
    } поймать (ошибка) {
        вернуть ложь
    }
}


// --------------------------------------------
//   СРАВНЕНИЕ И ПРОВЕРКИ
// --------------------------------------------

функция сравнить_безопасно(а, б) {
    // Сравнение строк за постоянное время (защита от timing-атак)
    подключить_питон("hmac")
    попробовать {
        вернуть hmac.compare_digest(а, б)
    } поймать (ошибка) {
        вернуть ложь
    }
}

функция контрольная_сумма(текст, алгоритм) {
    // CRC32-контрольная сумма (по умолчанию)
    подключить_питон("zlib")
    
    если (алгоритм == ничего) {
        алгоритм = "crc32"
    }
    
    если (алгоритм == "crc32") {
        вернуть zlib.crc32(текст.encode("utf-8"))
    }
    
    бросить "Поддерживается только crc32"
}
